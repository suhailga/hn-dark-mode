{
  "manifest_version": 3,
  "name": "HN Dark Mode",
  "version": "1.3.0",
  "description": "Dark mode and configurable top posts over 12-hour and 1-day windows for Hacker News.",
  "permissions": ["storage"],
  "host_permissions": ["https://hn.algolia.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "HN Dark Mode",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://news.ycombinator.com/*",
        "http://news.ycombinator.com/*"
      ],
      "css": ["dark-mode.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
